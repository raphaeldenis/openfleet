{
  "name": "openfleet",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm -r --filter './packages/*' exec tsc --noEmit && pnpm --filter @openfleet/desktop exec tsc -p tsconfig.app.json --noEmit",
    "arch": "depcruise packages/core/src packages/shared/src apps/desktop/src --config .dependency-cruiser.cjs --ts-pre-compilation-deps --ignore-known .dependency-cruiser-known-violations.json",
    "docs:errors": "pnpm --filter @openfleet/core exec tsx ../../scripts/errors/generateErrorReference.ts",
    "dev:core": "pnpm --filter @openfleet/core dev",
    "dev:desktop": "pnpm --filter @openfleet/desktop tauri dev",
    "dev": "concurrently -k \"pnpm dev:core\" \"pnpm dev:desktop\"",
    "build:dmg": "bash scripts/release/build-local.sh",
    "build:dmg:all": "bash scripts/release/build-local.sh --target x86_64-apple-darwin && bash scripts/release/build-local.sh --target aarch64-apple-darwin",
    "e2e": "pnpm --filter @openfleet/desktop exec playwright test",
    "postinstall": "pnpm --filter @openfleet/core run fix-node-pty-permissions",
    "prepare": "husky"
  },
  "devDependencies": {
    "@openfleet/shared": "workspace:*",
    "@types/node": "^26.0.0",
    "concurrently": "^10.0.5",
    "dependency-cruiser": "^18.5.0",
    "husky": "^9.1.7",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
